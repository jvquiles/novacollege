      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Novacollege.Data\Novacollege.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Novacollege.Business\Novacollege.Business.csproj" />
  </ItemGroup>

